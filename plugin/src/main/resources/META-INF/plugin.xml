<idea-plugin>
  <id>local.codex.commitmessage</id>
  <name>CodexCommit</name>
  <version>1.1.6</version>
  <vendor>CodexCommit contributors</vendor>
  <description><![CDATA[
    <p>This plugin uses Codex in PyCharm to prepare<br>
    short commit messages from selected Git<br>
    changes. Select the files, then select the<br>
    CodexCommit button. The draft appears in the<br>
    commit message field. Examine it before you<br>
    commit. The plugin needs a compatible Codex<br>
    CLI and an active personal account to work.</p>
    <p><img src="data:image/png;base64," width="400" height="84" alt="CodexCommit button in the Commit window"></p>
  ]]></description>
  <change-notes><![CDATA[
    <h3>Version 1.1.6</h3>
    <ul>
      <li>Show the Commit button in the plugin Overview.</li>
      <li>Keep What's New short and specific to this version.</li>
    </ul>
  ]]></change-notes>
  <idea-version since-build="262.10968.92" until-build="262.*"/>
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.vcs</depends>
  <depends>Git4Idea</depends>
  <extensions defaultExtensionNs="com.intellij">
    <notificationGroup id="CodexCommit" displayType="BALLOON" isLogByDefault="false"/>
    <applicationConfigurable id="dev.codexcommit.settings" parentId="tools"
      displayName="CodexCommit" instance="dev.codexcommit.ide.CodexCommitConfigurable"/>
  </extensions>
  <actions>
    <action id="CodexCommitMessage.Generate" class="dev.codexcommit.ide.GenerateCommitMessageAction"
      text="Generate Commit Message with CodexCommit"
      description="Send selected changes to Codex and fill the commit message"
      icon="/icons/codexcommit.svg">
      <add-to-group group-id="Vcs.MessageActionGroup" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
