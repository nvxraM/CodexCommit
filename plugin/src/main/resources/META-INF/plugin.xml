<idea-plugin url="https://github.com/nvxraM/CodexCommit">
  <id>local.codex.commitmessage</id>
  <name>CodexCommit</name>
  <version>1.1.11</version>
  <vendor email="nvxram.support@gmail.com" url="https://github.com/nvxraM/CodexCommit">nvxraM</vendor>
  <description><![CDATA[
    <div id="codexcommit-overview">
    <p>Generate short Git commit messages with your Codex CLI.</p>
    <ul>
      <li>Select tracked changes in the Commit window.</li>
      <li>Click the coloured CodexCommit button.</li>
      <li>Review the draft, then commit.</li>
    </ul>
    <p><a href="https://raw.githubusercontent.com/nvxraM/CodexCommit/3cbb38e74bb64aedf8478d5c85003edfa70661e1/plugin/docs/images/generate-button.png"><img id="codexcommit-button-preview" src="https://raw.githubusercontent.com/nvxraM/CodexCommit/3cbb38e74bb64aedf8478d5c85003edfa70661e1/plugin/docs/images/generate-button.png" width="640" height="135" alt="CodexCommit button in the Commit window."></a></p>
    <p>Click the image to view full size.</p>
    <p><b>Requirements</b><br>PyCharm 2026.2.3 on Windows or Linux.<br>Native Git and Codex CLI 0.160.1 or 0.163.0.<br>A personal, unmanaged Codex account.</p>
    <p>Sends selected source changes to OpenAI.<br>Check for private data before generation.</p>
    <p><a href="https://github.com/nvxraM/CodexCommit/blob/main/plugin/docs/USAGE.md">User guide</a> &middot; <a href="https://github.com/nvxraM/CodexCommit">GitHub</a> &middot; <a href="https://github.com/nvxraM/CodexCommit/blob/main/plugin/docs/PRIVACY.md">Privacy</a></p>
    </div>
  ]]></description>
  <change-notes><![CDATA[
    <h3>Version 1.1.11</h3>
    <ul>
      <li>Fix the Overview picture in Marketplace and the IDE.</li>
      <li>Align Documentation and Privacy links in Additional Info.</li>
      <li>Clarify setup requirements and commit steps.</li>
    </ul>
  ]]></change-notes>
  <idea-version since-build="262.10968.92" until-build="262.*"/>
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.vcs</depends>
  <depends>Git4Idea</depends>
  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceImplementation="dev.codexcommit.ide.CodexCommitOverview"/>
    <notificationGroup id="CodexCommit" displayType="BALLOON" isLogByDefault="false"/>
    <applicationConfigurable id="dev.codexcommit.settings" parentId="tools"
      displayName="CodexCommit" instance="dev.codexcommit.ide.CodexCommitConfigurable"/>
  </extensions>
  <applicationListeners>
    <listener class="dev.codexcommit.ide.CodexCommitOverview$Startup" topic="com.intellij.ide.AppLifecycleListener"/>
    <listener class="dev.codexcommit.ide.CodexCommitOverview$Startup" topic="com.intellij.ide.plugins.DynamicPluginListener"/>
  </applicationListeners>
  <actions>
    <action id="CodexCommitMessage.Generate" class="dev.codexcommit.ide.GenerateCommitMessageAction"
      text="Generate Commit Message with CodexCommit"
      description="Send selected changes to Codex and fill the commit message"
      icon="/icons/codexcommit.svg">
      <add-to-group group-id="Vcs.MessageActionGroup" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
